---
import Layout from '../../layouts/Layout.astro';

const jobs = {
  'technical-operations': { department:'Technical Operations', title:'Technical Operations & Implementation Intern', location:'Nairobi, Kenya · Field / Hybrid', description:'Help bring practical digital tools to baking businesses while learning how thoughtful technology reaches real customers.', responsibilities:['Support the rollout of baking-business tools with partner bakers','Document feedback and identify opportunities to improve the experience','Help create clear onboarding and support resources'], requirements:['Curious, practical and comfortable solving problems','Interest in technology, business or operations','Confident communicating with people from different backgrounds'] },
  'product-implementation': { department:'Product', title:'Product Implementation & Growth Intern', location:'Nairobi, Kenya · Field / Hybrid', description:'Work closely with bakers to understand their needs, test ideas and help shape how the Rumy Cakes App grows.', responsibilities:['Assist with product rollouts and learner feedback','Help partners organise product information and customer journeys','Turn observations into clear ideas for the product team'], requirements:['Curious about products, people and small business growth','Comfortable learning from real customer conversations','Self-directed, organised and kind'] }
};

export const getStaticPaths = () => {
  return Object.keys(jobs).map((id) => ({
    params: { id },
  }));
};

const job = jobs[Astro.params.id as keyof typeof jobs];
if (!job) return Astro.redirect('/careers');
---
<Layout title={`${job.title} | Rumy Cakes`}><section class="page-hero"><div class="page-hero-inner"><div><span class="eyebrow">{job.department}</span><h1 class="display">{job.title}</h1><p>{job.location}</p></div><div class="note">{job.description}</div></div></section><section class="section"><div class="story-grid"><div><span class="eyebrow">The role</span><h2 class="section-title">Make the everyday experience better.</h2><ul class="check-list">{job.responsibilities.map(item => <li>{item}</li>)}</ul></div><div><span class="eyebrow">What you bring</span><h2 class="section-title">A practical, generous mindset.</h2><ul class="check-list">{job.requirements.map(item => <li>{item}</li>)}</ul><a class="button" href={`mailto:careers@rumycakes.com?subject=${encodeURIComponent(`Application: ${job.title}`)}`}>Apply by email</a></div></div></section></Layout>
