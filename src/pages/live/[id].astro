---
// src/pages/live/[id].astro
export const prerender = false; // Crucial: Allows any random ID without build errors

const { id } = Astro.params;
const streamUrl = `https://rumycakes.com/live/${id}`;
const appLink = `rumycakes://live/${id}`;

// PRODUCTION PLAY STORE LINK
const playStoreLink = "https://play.google.com/store/apps/details?id=com.rumycakes.app";

// OG Image: Using your actual logo so WhatsApp/Twitter previews never show a broken image
const ogImage = "https://rumycakes.com/rumy-cakes-logo.png"; 
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="theme-color" content="#fbfbfd" />
    
    <!-- SEO & Social Sharing -->
    <title>Join a Live Baking Stream | Rumy Cakes</title>
    <meta name="description" content="Watch artisan bakers create fresh cakes live, chat in real-time, and order directly to your door." />
    
    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={streamUrl} />
    <meta property="og:title" content="🔴 LIVE: Join the Baking Stream on Rumy Cakes" />
    <meta property="og:description" content="Watch, chat, and order fresh artisanal cakes in real-time. Tap to join the stream!" />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={streamUrl} />
    <meta property="twitter:title" content=" LIVE: Join the Baking Stream on Rumy Cakes" />
    <meta property="twitter:description" content="Watch, chat, and order fresh artisanal cakes in real-time." />
    <meta property="twitter:image" content={ogImage} />

    <style>
      /* --- Apple Minimal Design - Production Optimized --- */
      :root {
        --apple-ink: #1d1d1f;
        --apple-muted: #86868b;
        --apple-cream: #fbfbfd;
        --apple-accent: #cc4d70;
        --ease-apple: cubic-bezier(0.16, 1, 0.3, 1);
      }

      * { 
        box-sizing: border-box; 
        margin: 0; 
        padding: 0; 
      }
      
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'DM Sans', sans-serif;
        background: var(--apple-cream);
        color: var(--apple-ink);
        height: 100vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      .bg-layer {
        position: absolute; 
        top: 0; 
        left: 0; 
        width: 100%; 
        height: 100%;
        background: radial-gradient(circle at 50% 0%, rgba(204, 77, 112, 0.08) 0%, transparent 60%);
        z-index: 0;
        pointer-events: none;
      }

      .content {
        position: relative; 
        z-index: 1; 
        flex: 1;
        display: flex; 
        flex-direction: column; 
        align-items: center; 
        justify-content: center;
        padding: 2rem 5vw; 
        text-align: center;
      }

      /* --- Apple-Style Circular Logo --- */
      .app-logo {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        margin-bottom: 2rem;
        border: 1px solid rgba(29, 29, 31, 0.1);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
        background: #ffffff;
      }

      .live-badge {
        display: inline-flex; 
        align-items: center; 
        gap: 0.5rem;
        background: rgba(204, 77, 112, 0.1); 
        border: 1px solid rgba(204, 77, 112, 0.2);
        padding: 0.5rem 1.25rem; 
        border-radius: 980px; 
        margin-bottom: 2rem;
      }

      .live-dot {
        width: 6px; 
        height: 6px; 
        background: var(--apple-accent); 
        border-radius: 50%;
        animation: pulse 2s var(--ease-apple) infinite;
      }

      @keyframes pulse { 
        0%, 100% { opacity: 1; transform: scale(1); } 
        50% { opacity: 0.5; transform: scale(0.9); } 
      }

      .live-text { 
        font-size: 0.75rem; 
        font-weight: 600; 
        color: var(--apple-accent); 
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      h1 {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(2rem, 6vw, 3rem); 
        font-weight: 600; 
        line-height: 1.1; 
        margin-bottom: 1rem; 
        letter-spacing: -0.03em;
        color: var(--apple-ink);
      }

      p { 
        font-size: 1.125rem; 
        color: var(--apple-muted); 
        margin-bottom: 3rem; 
        line-height: 1.6; 
        max-width: 420px;
        font-weight: 400;
      }

      .actions { 
        width: 100%; 
        max-width: 320px; 
        display: flex; 
        flex-direction: column; 
        gap: 1rem; 
      }

      .btn {
        display: flex; 
        align-items: center; 
        justify-content: center; 
        gap: 0.5rem;
        width: 100%; 
        padding: 1rem 2rem; 
        border-radius: 980px; 
        font-weight: 500; 
        font-size: 1rem;
        text-decoration: none; 
        transition: all 0.3s var(--ease-apple); 
        border: none; 
        cursor: pointer;
        font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
      }
      
      .btn:active { 
        transform: scale(0.98); 
      }

      .btn-primary { 
        background: var(--apple-ink); 
        color: #ffffff; 
        box-shadow: 0 4px 16px rgba(29, 29, 31, 0.15);
      }

      .btn-primary:hover {
        background: var(--apple-accent);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(204, 77, 112, 0.25);
      }
      
      .btn-secondary { 
        background: transparent; 
        color: var(--apple-ink); 
        border: 1px solid rgba(29, 29, 31, 0.2);
      }

      .btn-secondary:hover {
        background: rgba(29, 29, 31, 0.05);
        border-color: rgba(29, 29, 31, 0.3);
      }

      .footer { 
        padding: 2rem 5vw; 
        text-align: center; 
        font-size: 0.875rem; 
        color: var(--apple-muted); 
        position: relative; 
        z-index: 1; 
      }
      
      .footer a { 
        color: var(--apple-accent); 
        text-decoration: none;
        font-weight: 500;
      }

      .footer a:hover {
        text-decoration: underline;
      }

      /* --- Mobile Optimizations --- */
      @media (max-width: 640px) {
        .app-logo {
          width: 72px;
          height: 72px;
          margin-bottom: 1.5rem;
        }

        h1 {
          font-size: 1.75rem;
        }

        p {
          font-size: 1rem;
          margin-bottom: 2.5rem;
        }

        .actions {
          max-width: 280px;
        }

        .btn {
          padding: 0.875rem 1.5rem;
          font-size: 0.95rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="bg-layer"></div>
    
    <div class="content">
      <!-- Circular Logo -->
      <img src="/rumy-cakes-logo.png" alt="Rumy Cakes" class="app-logo" />
      
      <div class="live-badge">
        <div class="live-dot"></div>
        <span class="live-text">Live Now</span>
      </div>

      <h1>Join the Live Baking Stream</h1>
      <p>Watch artisan bakers, chat in real-time, and order fresh cakes directly to your door.</p>

      <div class="actions">
        <a href={playStoreLink} class="btn btn-primary">
          Download App to Join
        </a>
        <a href={appLink} class="btn btn-secondary">
          Open in App
        </a>
      </div>
    </div>

    <div class="footer">
      Powered by <a href="/">Rumy Cakes</a>
    </div>
  </body>
</html>