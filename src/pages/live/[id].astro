---
// src/pages/live/[id].astro
export const prerender = false; // Crucial: Allows any random ID without build errors

const { id } = Astro.params;
const streamUrl = `https://rumycakes.com/live/${id}`;
const appLink = `rumycakes://live/${id}`;

// PRODUCTION PLAY STORE LINK
const playStoreLink = "https://play.google.com/store/apps/details?id=com.rumycakes.app";

// OG Image: Using your actual logo so WhatsApp/Twitter previews never show a broken image
const ogImage = "https://rumycakes.com/rumy-cakes-logo.png"; 
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="theme-color" content="#000000" />
    
    <!-- SEO & Social Sharing -->
    <title>Join a Live Baking Stream | Rumy Cakes</title>
    <meta name="description" content="Watch artisan bakers create fresh cakes live, chat in real-time, and order directly to your door." />
    
    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={streamUrl} />
    <meta property="og:title" content="🔴 LIVE: Join the Baking Stream on Rumy Cakes" />
    <meta property="og:description" content="Watch, chat, and order fresh artisanal cakes in real-time. Tap to join the stream!" />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={streamUrl} />
    <meta property="twitter:title" content="🔴 LIVE: Join the Baking Stream on Rumy Cakes" />
    <meta property="twitter:description" content="Watch, chat, and order fresh artisanal cakes in real-time." />
    <meta property="twitter:image" content={ogImage} />

    <style>
      /* Apple Minimal Design - Production Optimized */
      * { box-sizing: border-box; margin: 0; padding: 0; }
      
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', sans-serif;
        background: #000000;
        color: #ffffff;
        height: 100vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        -webkit-font-smoothing: antialiased;
      }

      .bg-layer {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        background: radial-gradient(circle at center, #2a0a18 0%, #000000 100%);
        z-index: 0;
      }

      .content {
        position: relative; z-index: 1; flex: 1;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        padding: 2rem; text-align: center;
      }

      /* --- Apple-Style Circular Logo --- */
      .app-logo {
        width: 72px;
        height: 72px;
        border-radius: 50%; /* Perfect circle like an iOS app icon */
        object-fit: cover;
        margin-bottom: 1.5rem;
        border: 1px solid rgba(255, 255, 255, 0.15); /* Subtle premium border */
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4); /* Depth without being heavy */
        background: #ffffff; /* Clean fallback if logo has transparency */
      }

      .live-badge {
        display: inline-flex; align-items: center; gap: 0.5rem;
        background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4);
        padding: 0.4rem 1rem; border-radius: 999px; margin-bottom: 1.5rem;
      }

      .live-dot {
        width: 8px; height: 8px; background: #ef4444; border-radius: 50%;
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
      }

      @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

      .live-text { font-size: 0.75rem; font-weight: 700; color: #ef4444; letter-spacing: 0.1em; }

      h1 {
        font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif;
        font-size: clamp(1.75rem, 5vw, 2.5rem); font-weight: 800; line-height: 1.15; 
        margin-bottom: 1rem; letter-spacing: -0.02em;
      }

      p { font-size: 1.05rem; color: #a1a1a6; margin-bottom: 3rem; line-height: 1.5; max-width: 400px; }

      .actions { width: 100%; max-width: 340px; display: flex; flex-direction: column; gap: 1rem; }

      .btn {
        display: flex; align-items: center; justify-content: center; gap: 0.75rem;
        width: 100%; padding: 1rem; border-radius: 14px; font-weight: 700; font-size: 1rem;
        text-decoration: none; transition: transform 0.2s ease; border: none; cursor: pointer;
      }
      .btn:active { transform: scale(0.98); }

      .btn-primary { 
        background: #9d174d; 
        color: #ffffff; 
        box-shadow: 0 8px 24px rgba(157, 23, 77, 0.4); 
      }
      
      .btn-secondary { 
        background: rgba(255, 255, 255, 0.1); 
        color: #ffffff; 
        border: 1px solid rgba(255, 255, 255, 0.15); 
        backdrop-filter: blur(10px); 
      }

      .footer { 
        padding: 1.5rem; 
        text-align: center; 
        font-size: 0.75rem; 
        color: #52525b; 
        position: relative; 
        z-index: 1; 
      }
      .footer a { color: #9d174d; text-decoration: none; }
    </style>
  </head>
  <body>
    <div class="bg-layer"></div>
    
    <div class="content">
      <!-- Circular Logo -->
      <img src="/rumy-cakes-logo.png" alt="Rumy Cakes" class="app-logo" />
      
      <div class="live-badge">
        <div class="live-dot"></div>
        <span class="live-text">LIVE NOW</span>
      </div>

      <h1>Join the Live Baking Stream</h1>
      <p>Watch artisan bakers, chat in real-time, and order fresh cakes directly to your door.</p>

      <div class="actions">
        <a href={playStoreLink} class="btn btn-primary">
          Download App to Join
        </a>
        <a href={appLink} class="btn btn-secondary">
          Open in App
        </a>
      </div>
    </div>

    <div class="footer">
      Powered by <a href="/">Rumy Cakes</a>
    </div>
  </body>
</html>