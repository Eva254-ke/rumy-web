---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Order a Cake | Rumy Cakes">
  
  <!-- 1. Clean, Typographic Hero -->
  <section class="hero-orders" data-spring-scene>
    <div class="hero-inner" data-spring-reveal>
      <span class="section-label">Baking &amp; Cake Orders</span>
      <h1 class="display-hero">Beautiful cakes. <em>Memorable celebrations.</em></h1>
      <p class="hero-lead">From birthdays to weddings and every special milestone, we'll help bring your sweetest idea to life.</p>
      <p class="hero-note">Tell us your occasion, preferred design, flavour, size, and date. We will guide you from there.</p>
    </div>
  </section>

  <!-- 2. Alternating Zigzag Feature Rows (Apple Style) -->
  <section class="features-container">
    
    <!-- Row 1: Birthdays (Image Left, Text Right) -->
    <div class="feature-row" data-reveal style="--delay: 0s;">
      <div class="feature-visual">
        <img src="https://i.ibb.co/d4WmqkmK/image.png" alt="Beautiful birthday celebration cake" loading="lazy" />
      </div>
      <div class="feature-content">
        <span class="section-label">01. Birthdays</span>
        <h2 class="feature-heading">Intimate celebrations, perfectly crafted.</h2>
        <p class="feature-text">Whether it is a milestone birthday or a quiet gathering, we design custom cakes that reflect the personality and joy of the guest of honor.</p>
        <a href="https://wa.me/254792414264?text=Hello%20Rumy%20Cakes%2C%20I%20would%20like%20to%20order%20a%20birthday%20cake." target="_blank" rel="noreferrer" class="button-primary" style="padding: 12px 28px; font-size: 1rem;">Order a birthday cake</a>
      </div>
    </div>

    <!-- Row 2: Weddings (Text Left, Image Right) -->
    <div class="feature-row alt-bg" data-reveal style="--delay: 0.1s;">
      <div class="feature-visual">
        <img src="https://i.ibb.co/gZXZ8M3W/image.png" alt="Elegant wedding and engagement cake" loading="lazy" />
      </div>
      <div class="feature-content">
        <span class="section-label">02. Weddings &amp; Engagements</span>
        <h2 class="feature-heading">The centerpiece of your special day.</h2>
        <p class="feature-text">From elegant, minimalist tiers to elaborate floral designs, we work closely with you to create a stunning cake that complements your wedding theme.</p>
        <a href="https://wa.me/254792414264?text=Hello%20Rumy%20Cakes%2C%20I%20would%20like%20to%20enquire%20about%20a%20wedding%20cake." target="_blank" rel="noreferrer" class="button-primary" style="padding: 12px 28px; font-size: 1rem;">Discuss your wedding cake</a>
      </div>
    </div>

    <!-- Row 3: Graduations (Image Left, Text Right) -->
    <div class="feature-row" data-reveal style="--delay: 0.2s;">
      <div class="feature-visual">
        <img src="https://i.ibb.co/QtndPcd/image.png" alt="Custom graduation achievement cake" loading="lazy" />
      </div>
      <div class="feature-content">
        <span class="section-label">03. Graduations</span>
        <h2 class="feature-heading">Celebrate the achievement.</h2>
        <p class="feature-text">Mark academic and professional milestones with a cake that proudly displays the accomplishment, tailored to your school colors or corporate branding.</p>
        <a href="https://wa.me/254792414264?text=Hello%20Rumy%20Cakes%2C%20I%20would%20like%20to%20order%20a%20graduation%20cake." target="_blank" rel="noreferrer" class="button-primary" style="padding: 12px 28px; font-size: 1rem;">Order a graduation cake</a>
      </div>
    </div>

    <!-- Row 4: Anniversaries & More (Text Left, Image Right) -->
    <div class="feature-row alt-bg" data-reveal style="--delay: 0.3s;">
      <div class="feature-visual">
        <img src="https://i.ibb.co/wNWYWpyH/image.png" alt="Anniversary and baby shower celebration cake" loading="lazy" />
      </div>
      <div class="feature-content">
        <span class="section-label">04. Anniversaries &amp; More</span>
        <h2 class="feature-heading">Every moment deserves sweetness.</h2>
        <p class="feature-text">Baby showers, corporate events, or just because. If you have a reason to celebrate, we have the creativity and skill to make it unforgettable.</p>
        <a href="https://wa.me/254792414264?text=Hello%20Rumy%20Cakes%2C%20I%20would%20like%20to%20enquire%20about%20a%20custom%20cake." target="_blank" rel="noreferrer" class="button-primary" style="padding: 12px 28px; font-size: 1rem;">Enquire about your event</a>
      </div>
    </div>

  </section>

  <!-- 3. Minimal, Edge-to-Edge CTA -->
  <section class="cta-section" data-reveal>
    <div class="cta-inner">
      <span class="section-label">Cake Orders</span>
      <h2 class="display-small">Let's make it special.</h2>
      <p class="hero-lead">Call or WhatsApp us with your cake idea, and our team will help you design the perfect centerpiece for your event.</p>
      <div class="cta-actions">
        <a class="button-primary" href="https://wa.me/254792414264?text=Hello%20Rumy%20Cakes%2C%20I%20would%20like%20to%20order%20a%20cake." target="_blank" rel="noreferrer">Chat on WhatsApp</a>
        <a class="link-secondary" href="tel:+254792414264">0792 414 264</a>
      </div>
      <p class="order-notice">Please confirm lead times, delivery coverage, and payment details when placing your order.</p>
    </div>
  </section>

</Layout>

<style>
  /* --- Apple-Grade Design System Overrides --- */
  :root {
    --apple-ink: #1d1d1f;
    --apple-muted: #86868b;
    --apple-cream: #fbfbfd;
    --apple-surface: #f5f5f7;
    --apple-accent: #b02e4f;
    --apple-rule: rgba(0, 0, 0, 0.1);
    --ease-apple: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* --- Base Typography --- */
  .section-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--apple-accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 16px;
  }

  .display-hero {
    font-family: var(--serif, 'Playfair Display', Georgia, serif);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--apple-ink);
    margin: 0 0 24px;
  }

  .display-hero em {
    color: var(--apple-accent);
    font-style: italic;
  }

  .display-small {
    font-family: var(--serif, 'Playfair Display', Georgia, serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--apple-ink);
    margin: 0 0 24px;
  }

  .hero-lead, .feature-text {
    font-size: clamp(1.125rem, 2vw, 1.35rem);
    line-height: 1.5;
    color: var(--apple-muted);
    max-width: 680px;
    margin: 0 0 32px;
  }

  .hero-note {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--apple-muted);
    max-width: 600px;
    margin: 0 auto;
    padding-top: 24px;
    border-top: 1px solid var(--apple-rule);
  }

  /* --- Hero Section --- */
  .hero-orders {
    padding: clamp(80px, 12vw, 140px) 5vw clamp(60px, 8vw, 100px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--apple-cream);
  }

  .hero-inner {
    will-change: transform;
    transform: translate3d(var(--spring-x, 0), var(--spring-y, 0), 0);
    max-width: 900px;
  }

  /* --- Alternating Zigzag Feature Rows --- */
  .features-container {
    width: 100%;
  }

  .feature-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8vw;
    align-items: center;
    padding: clamp(80px, 10vw, 140px) 5vw;
    background: var(--apple-cream);
  }

  /* Alternating Rule: Reverse order and change background for even rows */
  .feature-row.alt-bg {
    background: var(--apple-surface);
  }
  
  .feature-row.alt-bg .feature-visual {
    order: 2;
  }
  
  .feature-row.alt-bg .feature-content {
    order: 1;
  }

  .feature-visual img {
    width: 100%;
    height: auto;
    border-radius: 24px;
    box-shadow: 0 32px 64px -12px rgba(0, 0, 0, 0.08);
    transition: transform 0.6s var(--ease-apple);
  }

  .feature-visual img:hover {
    transform: scale(1.01);
  }

  .feature-heading {
    font-family: var(--serif, 'Playfair Display', Georgia, serif);
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--apple-ink);
    margin: 0 0 20px;
  }

  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--apple-accent);
    font-size: 1.125rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: gap 0.3s var(--ease-apple);
  }

  .link-arrow::after {
    content: '→';
    font-size: 1.4rem;
    line-height: 1;
    transition: transform 0.3s var(--ease-apple);
  }

  .link-arrow:hover {
    gap: 12px;
  }

  .link-arrow:hover::after {
    transform: translateX(4px);
  }

  /* --- CTA Section --- */
  .cta-section {
    padding: clamp(80px, 12vw, 140px) 5vw;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--apple-surface);
  }

  .cta-inner {
    max-width: 800px;
    will-change: transform;
    transform: translate3d(var(--spring-x, 0), var(--spring-y, 0), 0);
  }

  .cta-actions {
    display: flex;
    gap: 32px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 32px;
  }

  .button-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--apple-ink);
    color: #fff;
    padding: 16px 36px;
    border-radius: 980px;
    font-size: 1.05rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s var(--ease-apple);
  }

  .button-primary:hover {
    background: var(--apple-accent);
    transform: scale(1.02);
  }

  .link-secondary {
    color: var(--apple-accent);
    font-size: 1.125rem;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease-apple);
    padding-bottom: 2px;
  }

  .link-secondary:hover {
    border-bottom-color: var(--apple-accent);
  }

  .order-notice {
    margin-top: 48px;
    font-size: 0.9rem;
    color: var(--apple-muted);
    max-width: 500px;
    line-height: 1.5;
  }

  /* --- Animations --- */
  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s var(--ease-apple), transform 0.8s var(--ease-apple);
    transition-delay: var(--delay, 0s);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  [data-spring-reveal] {
    animation: spring-arrive 0.9s var(--ease-spring) both;
  }

  @keyframes spring-arrive {
    from { opacity: 0; transform: translateY(32px) scale(0.97); }
    60% { opacity: 1; transform: translateY(-4px) scale(1.005); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* --- Responsive Adjustments --- */
  @media (max-width: 900px) {
    .feature-row {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }

    /* On mobile, always show image first, then text */
    .feature-row .feature-visual {
      order: -1 !important;
    }

    .feature-row .feature-content {
      order: 1 !important;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .feature-text {
      margin-left: auto;
      margin-right: auto;
    }

    .cta-actions {
      flex-direction: column;
      gap: 20px;
      width: 100%;
    }
    
    .button-primary, .link-secondary {
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal], [data-spring-reveal] {
      animation: none !important;
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .hero-inner, .cta-inner {
      transform: none !important;
    }
  }
</style>

<script>
  const reveals = document.querySelectorAll('[data-reveal]');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

  reveals.forEach((element) => observer.observe(element));

  const scenes = document.querySelectorAll('[data-spring-scene]');
  scenes.forEach((scene) => {
    const targets = scene.querySelectorAll('.hero-inner, .cta-inner');
    if (!targets.length || !window.matchMedia('(pointer: fine)').matches) return;

    let targetX = 0, targetY = 0, currentX = 0, currentY = 0, frame = 0;
    
    const tick = () => {
      currentX += (targetX - currentX) * 0.08;
      currentY += (targetY - currentY) * 0.08;
      
      targets.forEach((el, index) => {
        const factor = index === 0 ? 1 : 0.6;
        const htmlEl = /** @type {HTMLElement} */ (el);
        htmlEl.style.setProperty('--spring-x', `${currentX * factor}px`);
        htmlEl.style.setProperty('--spring-y', `${currentY * factor}px`);
      });
      
      frame = requestAnimationFrame(tick);
    };
    
    scene.addEventListener('pointermove', (event) => {
      const pointerEvent = /** @type {PointerEvent} */ (event);
      const box = scene.getBoundingClientRect();
      targetX = ((pointerEvent.clientX - box.left) / box.width - 0.5) * 16;
      targetY = ((pointerEvent.clientY - box.top) / box.height - 0.5) * 12;
    });
    
    scene.addEventListener('pointerleave', () => {
      targetX = 0;
      targetY = 0;
    });
    
    tick();
    window.addEventListener('pagehide', () => cancelAnimationFrame(frame), { once: true });
  });
</script>