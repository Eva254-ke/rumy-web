---
// src/components/CareersHeader.astro
import './CareersHeader.css';
---

<header class="careers-header">
  <div class="container header-inner">
    
    <!-- Left Side: Logo Only -->
    <a href="/" class="logo">
      <img src="/rumy-cakes-logo.png" alt="Rumy Cakes" width="32" height="32" />
      <span>Rumy Cakes</span>
    </a>
    
    <!-- Right Side: Text + Button Group -->
    <div class="header-right">
      <span class="header-subtitle">Working at Rumy Cakes</span>
      <a href="#open-roles" class="btn btn-primary btn-sm">
        Discover Jobs
      </a>
    </div>

  </div>
</header>