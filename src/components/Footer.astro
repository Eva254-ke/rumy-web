---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-grid">
      
      <!-- Column 1: Brand & Intro (Spans full width on mobile) -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-brand" aria-label="Rumy Cakes home">
          <img src="/rumy-cakes-logo.png" alt="Rumy Cakes Logo" width="32" height="32" />
          <span class="brand-text">
            <b>Rumy</b> Cakes
          </span>
        </a>
        <p class="footer-tagline">Making celebrations sweeter—and helping bakers create their next chapter.</p>
        <a class="footer-phone" href="tel:+254792414264">+254 792 414 264</a>
      </div>

      <!-- Column 2: Explore -->
      <div class="footer-col">
        <h3 class="footer-heading">Explore</h3>
        <nav class="footer-nav">
          <a href="/orders">Cake orders</a>
          <a href="/training">Rumy Baking Academy</a>
          <a href="/accessories">Cake accessories</a>
          <a href="/app">Rumy Cakes App</a>
          <a href="/careers">Careers</a>
        </nav>
      </div>

      <!-- Column 3: Visit & Connect -->
      <div class="footer-col">
        <h3 class="footer-heading">Visit & Connect</h3>
        <p class="footer-address">
          Ruiru Town, Tulivu Arcade<br />
          Shop 40/41, Kiambu County
        </p>
        <nav class="footer-nav">
          <a href="/contact">Contact us</a>
          <a href="https://www.tiktok.com/@rumycakesruiru" target="_blank" rel="noreferrer" class="external-link">TikTok</a>
          <a href="https://www.facebook.com/Rumycakes" target="_blank" rel="noreferrer" class="external-link">Facebook</a>
        </nav>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="footer-base">
      <span>© {currentYear} Rumy Cakes & Accessories</span>
      <span class="footer-motto">We Bake. We Train. We Supply. We Innovate.</span>
    </div>
  </div>
</footer>

<style>
  /* --- Apple-Grade Footer Styles --- */
  .site-footer {
    background: var(--apple-surface, #f5f5f7);
    color: var(--apple-muted, #86868b);
    padding: 64px 5vw 32px;
    font-family: var(--sans, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    font-size: 0.875rem;
    line-height: 1.5;
    width: 100%;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Brand Column */
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--apple-ink, #1d1d1f);
    margin-bottom: 8px;
    transition: opacity 0.3s ease;
  }

  .footer-brand:hover {
    opacity: 0.8;
  }

  .footer-brand img {
    border-radius: 50%;
    object-fit: cover;
  }

  .brand-text {
    font-family: var(--serif, 'Playfair Display', Georgia, serif);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .brand-text b {
    font-weight: 700;
  }

  .footer-tagline {
    max-width: 280px;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .footer-phone {
    color: var(--apple-ink, #1d1d1f);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: color 0.3s ease;
    display: inline-block;
    margin-top: 8px;
  }

  .footer-phone:hover {
    color: var(--apple-accent, #b02e4f);
  }

  /* Headings */
  .footer-heading {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--apple-ink, #1d1d1f);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 8px;
  }

  /* Navigation Links */
  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-nav a {
    color: var(--apple-muted, #86868b);
    text-decoration: none;
    transition: color 0.3s ease, transform 0.3s ease;
    display: inline-block;
    width: max-content;
  }

  .footer-nav a:hover {
    color: var(--apple-ink, #1d1d1f);
    transform: translateX(4px);
  }

  /* External Links (No emojis, clean CSS arrow) */
  .external-link::after {
    content: '→';
    margin-left: 4px;
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.3s ease;
    display: inline-block;
  }

  .external-link:hover::after {
    opacity: 1;
    transform: translateX(0);
  }

  .footer-address {
    margin: 0;
    font-style: normal;
    line-height: 1.6;
  }

  /* Bottom Bar */
  .footer-base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    font-size: 0.8rem;
    color: var(--apple-muted, #86868b);
    flex-wrap: wrap;
    gap: 16px;
  }

  .footer-motto {
    font-weight: 500;
    color: var(--apple-ink, #1d1d1f);
    letter-spacing: 0.02em;
  }

  /* --- Apple-Style Mobile Adjustments (Prevents Endless Scrolling) --- */
  @media (max-width: 768px) {
    .site-footer {
      padding: 40px 5vw 24px;
    }

    .footer-grid {
      /* Use a 2-column grid for links to save vertical space */
      grid-template-columns: 1fr 1fr;
      gap: 32px 24px;
      margin-bottom: 32px;
    }

    /* Brand column spans full width at the top */
    .brand-col {
      grid-column: 1 / -1;
      margin-bottom: 8px;
      gap: 12px;
    }

    .footer-tagline {
      max-width: 100%;
      font-size: 0.85rem;
    }

    .footer-heading {
      font-size: 0.7rem;
      margin-bottom: 12px;
    }

    .footer-nav {
      gap: 10px;
    }

    .footer-nav a {
      font-size: 0.85rem;
    }

    .footer-address {
      font-size: 0.85rem;
      margin-bottom: 12px;
    }

    .footer-base {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding-top: 20px;
      font-size: 0.75rem;
    }
  }
</style>