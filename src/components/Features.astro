---
import './Features.css';
---

<section class="features-section" id="marketplace">
  <div class="features-inner">
    
    <!-- LEFT: Image -->
    <div class="features-image">
      <img src="https://i.ibb.co/hFj8GWVZ/image.png" alt="Rumy Cakes marketplace" />
    </div>

    <!-- RIGHT: Content & QR Code -->
    <div class="features-content">
      <h2 class="features-title">We've got it all.</h2>
      <p class="features-subtitle">Search our marketplace to find the exact cake you're looking for.</p>
      
      <div class="qr-section">
        <p class="qr-label">Download Rumy Cakes</p>
        <div class="qr-code-wrapper">
          <a href="https://play.google.com/apps/testing/com.rumycakes.app" class="qr-link" aria-label="Download Rumy Cakes">
            <img src="/rumy-cakes-google-play.png" alt="QR code to download Rumy Cakes" width="140" height="140" />
          </a>
        </div>
      </div>
    </div>

  </div>
</section>
