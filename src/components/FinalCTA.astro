---
import './FinalCTA.css';
---

<section class="final-cta" id="download">
  <div class="cta-inner">
    
    <!-- LEFT: Content -->
    <div class="cta-content">
      <h2 class="cta-title">A good cake<br />changes the room.</h2>
      <p class="cta-subtitle">Download Rumy Cakes to find a baker you'll love, catch their next live session, and turn an ordinary day into something worth gathering for.</p>
      
      <div class="cta-download">
        <div class="download-block">
          <p class="download-label">Download Rumy Cakes</p>
          <div class="qr-code-wrapper">
            <a href="https://play.google.com/apps/testing/com.rumycakes.app" class="qr-link" aria-label="Download Rumy Cakes">
              <img src="/rumy-cakes-google-play.png" alt="QR code to download Rumy Cakes" width="140" height="140" />
            </a>
          </div>
          <p class="download-note">Scan to download on Android</p>
        </div>
      </div>
    </div>

    <!-- RIGHT: Image -->
    <div class="cta-visual">
      <img src="/cake-cta.png" alt="Elegant celebration cake" />
    </div>

  </div>

  <!-- Floating Back to Top Button -->
  <button class="floating-back-to-top" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" aria-label="Back to top">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>
</section>

<script>
  const backToTopBtn = document.querySelector('.floating-back-to-top');

  if (backToTopBtn) {
    window.addEventListener('scroll', () => {
      backToTopBtn.classList.toggle('visible', window.scrollY > 500);
    });
  }
</script>
