---
const path = Astro.url.pathname;
---

<header class="site-header" id="site-header">
  <!-- Sleek Announcement Bar -->
  <div class="announcement">
    <span>NEW: The Rumy Cakes App is here to help you bake, manage &amp; grow.</span>
    <a href="/app" class="announcement-link">
      Discover it <span class="arrow">→</span>
    </a>
  </div>

  <!-- Frosted Glass Navigation Shell -->
  <div class="nav-shell">
    <a href="/" class="brand" aria-label="Rumy Cakes home">
      <img src="/rumy-cakes-logo.png" alt="Rumy Cakes Logo" width="36" height="36" />
      <span class="brand-text">
        <b>Rumy</b> Cakes
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="/about" class:active={path === '/about'}>Our story</a>
      <a href="/orders" class:active={path === '/orders'}>Order a cake</a>
      <a href="/training" class:active={path === '/training'}>Academy</a>
      <a href="/accessories" class:active={path === '/accessories'}>Accessories</a>
      <a href="/app" class:active={path === '/app'}>Rumy App</a>
    </nav>

    <a class="nav-cta desktop-cta" href="https://wa.me/254792414264?text=Hello%20Rumy%20Cakes%2C%20I%20would%20like%20to%20place%20an%20order." target="_blank" rel="noreferrer">
      Let's talk
    </a>

    <!-- Mobile Menu Toggle (Standard 3-Line Hamburger) -->
    <button class="mobile-menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>

  <!-- Mobile Navigation Overlay -->
  <nav class="mobile-nav" aria-label="Mobile navigation">
    <div class="mobile-nav-inner">
      <a href="/about" class:active={path === '/about'}>Our story</a>
      <a href="/orders" class:active={path === '/orders'}>Order a cake</a>
      <a href="/training" class:active={path === '/training'}>Academy</a>
      <a href="/accessories" class:active={path === '/accessories'}>Accessories</a>
      <a href="/app" class:active={path === '/app'}>Rumy App</a>
      
      <div class="mobile-nav-divider"></div>
      
      <a class="nav-cta mobile-cta" href="https://wa.me/254792414264?text=Hello%20Rumy%20Cakes%2C%20I%20would%20like%20to%20place%20an%20order." target="_blank" rel="noreferrer">
        Chat on WhatsApp
      </a>
    </div>
  </nav>
</header>

<style>
  /* --- Apple-Grade Header Styles --- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background: rgba(251, 251, 253, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(29, 29, 31, 0.1);
    transition: background 0.3s ease;
  }

  /* Announcement Bar */
  .announcement {
    padding: 0.68rem 5vw;
    background: var(--ink, #1d1d1f);
    color: #fff;
    text-align: center;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    line-height: 1.4;
  }

  .announcement a {
    color: #fff;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: opacity 0.3s ease;
    white-space: nowrap;
  }

  .announcement a:hover {
    opacity: 0.8;
  }

  .announcement a .arrow {
    font-size: 1rem;
    line-height: 1;
    transition: transform 0.3s ease;
  }

  .announcement a:hover .arrow {
    transform: translateX(3px);
  }

  /* Navigation Shell */
  .nav-shell {
    width: 100%;
    height: 64px;
    padding: 0 5vw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 1.14rem;
    line-height: 0.98;
    white-space: nowrap;
    color: var(--ink, #1d1d1f);
    text-decoration: none;
  }

  .brand img {
    border-radius: 50%;
    object-fit: cover;
  }

  .brand-text {
    font-family: var(--serif, 'Playfair Display', Georgia, serif);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .brand-text b {
    font-weight: 700;
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .desktop-nav a {
    font-family: var(--sans, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted, #86868b);
    position: relative;
    transition: color 0.3s ease;
    text-decoration: none;
  }

  .desktop-nav a:hover,
  .desktop-nav a.active {
    color: var(--ink, #1d1d1f);
  }

  .desktop-nav a.active::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--pink, #cc4d70);
    border-radius: 2px;
  }

  .desktop-cta {
    display: inline-flex;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--ink, #1d1d1f);
    color: #fff;
    padding: 10px 22px;
    border-radius: 980px;
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .nav-cta:hover {
    background: var(--pink, #cc4d70);
    transform: scale(1.02);
  }

  /* =========================================
     MINIMALIST MOBILE MENU STYLES (3-Line Standard)
     ========================================= */
  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    gap: 6px;
    z-index: 1001;
  }

  /* Standard 3-line hamburger */
  .hamburger-line {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--ink, #1d1d1f);
    border-radius: 2px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: rgba(251, 251, 253, 0.98);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), 
                visibility 0.4s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-nav-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
    width: 100%;
    max-width: 320px;
  }

  /* Refined, minimalist link styling */
  .mobile-nav a:not(.nav-cta) {
    font-family: var(--sans, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    font-size: 1.125rem; /* 18px: highly legible but not bulky */
    font-weight: 500;
    color: var(--ink, #1d1d1f);
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: color 0.2s ease, transform 0.2s ease;
    padding: 4px 0;
  }

  .mobile-nav a:not(.nav-cta):hover {
    transform: translateX(4px);
  }

  .mobile-nav a:not(.nav-cta).active {
    color: var(--pink, #cc4d70);
    font-weight: 600;
  }

  /* Subtle divider before the CTA */
  .mobile-nav-divider {
    width: 40px;
    height: 1px;
    background: rgba(29, 29, 31, 0.1);
    margin: 8px 0;
  }

  .mobile-cta {
    width: 100%;
    padding: 14px 24px;
    font-size: 0.95rem;
    font-weight: 500;
  }

  /* Hamburger to 'X' Animation (Standard 3 lines) */
  .site-header.is-open .mobile-menu-toggle .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .site-header.is-open .mobile-menu-toggle .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  .site-header.is-open .mobile-menu-toggle .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* Menu Open State */
  .site-header.is-open .mobile-nav {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* Prevent background scrolling when menu is open */
  body.menu-open {
    overflow: hidden;
  }

  /* =========================================
     RESPONSIVE ADJUSTMENTS
     ========================================= */
  @media (max-width: 900px) {
    .announcement {
      padding: 6px 4vw;
      font-size: 0.7rem;
      line-height: 1.3;
      gap: 4px;
    }

    .announcement a .arrow {
      font-size: 0.8rem;
    }

    .nav-shell {
      height: 56px;
      padding: 0 4vw;
    }

    .brand {
      gap: 8px;
    }

    .brand img {
      width: 28px;
      height: 28px;
    }

    .brand-text {
      font-size: 1rem;
    }

    /* Hide desktop elements */
    .desktop-nav, .desktop-cta {
      display: none;
    }
    
    /* Show mobile toggle */
    .mobile-menu-toggle {
      display: flex;
    }
  }
</style>

<script>
  // Mobile Menu Logic
  const header = document.getElementById('site-header');
  const toggleBtn = header.querySelector('.mobile-menu-toggle');
  
  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = header.classList.toggle('is-open');
      toggleBtn.setAttribute('aria-expanded', isOpen);
      document.body.classList.toggle('menu-open', isOpen);
    });

    // Auto-close menu when a link is clicked
    const mobileLinks = header.querySelectorAll('.mobile-nav a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        header.classList.remove('is-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('menu-open');
      });
    });
  }
</script>