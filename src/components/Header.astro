---
import './Header.css';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Rumy Cakes home">
      <img src="/rumy-cakes-logo.png" alt="Rumy Cakes" />
      <span>Rumy Cakes</span>
    </a>
    
    <!-- Desktop Navigation -->
    <nav class="main-nav" aria-label="Main navigation">
      <a href="/become-a-seller">Apply to sell</a>
      <a href="#marketplace">Discover</a>
    </nav>
    
    <!-- Action Button (Always Visible) -->
    <div class="header-actions">
      <a href="https://play.google.com/apps/testing/com.rumycakes.app" class="btn btn-primary btn-sm">
        Get the app
      </a>
    </div>
  </div>
</header>