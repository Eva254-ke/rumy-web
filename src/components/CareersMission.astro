---
import './CareersMission.css';
---

<section class="careers-mission">
  <div class="mission-inner">
    
    <span class="mission-label">Our Mission</span>
    
    <h2 class="mission-statement">
      Empower local bakers to turn their passion into a thriving business and bring people together through the joy of live, artisanal baking.
    </h2>

    <div class="stats-grid">
      
      <!-- Stat 1 -->
      <div class="stat-item">
        <div class="stat-number">100%</div>
        <div class="stat-label">Baker-owned earnings</div>
        <p class="stat-desc">
          Every shilling from tips and sales goes directly to the artisan bakers on our platform. No hidden cuts.
        </p>
      </div>

      <!-- Stat 2 -->
      <div class="stat-item">
        <div class="stat-number">500+</div>
        <div class="stat-label">Hours of live baking</div>
        <p class="stat-desc">
          Our early community has spent over 500 hours watching, chatting, and interacting with bakers in real-time.
        </p>
      </div>

      <!-- Stat 3 -->
      <div class="stat-item">
        <div class="stat-number">50+</div>
        <div class="stat-label">Local artisan partners</div>
        <p class="stat-desc">
          We are proudly onboarding independent home bakers and pastry chefs, helping them reach a wider audience.
        </p>
      </div>

    </div>

  </div>
</section>
