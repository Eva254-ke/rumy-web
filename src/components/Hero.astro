<section class="hero">
  <div class="hero-grid">
    
    <!-- LEFT: Phone Mockups -->
    <div class="hero-phones">
      <div class="phone phone-back"></div>
      <div class="phone phone-main">
        <div class="phone-notch"></div>
        <video 
          autoplay 
          muted 
          loop 
          playsinline 
          poster="https://i.ibb.co/SSVWqRP/image.png"
          class="phone-video"
        >
          <source src="/hero.mp4" type="video/mp4" />
        </video>
        <div class="phone-live-badge">
          <span class="pulse-dot"></span>
          <span>LIVE</span>
          <span class="viewers">1.2K</span>
        </div>
        <div class="phone-ui-bottom">
          <div class="ui-avatar"></div>
          <div class="ui-text">
            <span class="ui-name">Rumy's Studio</span>
            <span class="ui-action">Baking now...</span>
          </div>
        </div>
      </div>
      <div class="phone phone-front"></div>
    </div>

    <!-- CENTER: Content -->
    <div class="hero-content">
      <h1 class="hero-headline">The cake you love.<br /><em>Made live.</em></h1>
      <p class="hero-subhead">Find incredible cakes from talented local bakers. Watch the finishing touches, chat with the maker, then make it yours.</p>
      
      <div class="download-block">
        <p class="download-label">Download Rumy Cakes</p>
        <div class="qr-card">
          <a href="https://play.google.com/apps/testing/com.rumycakes.app" aria-label="Download Rumy Cakes">
            <img src="/rumy-cakes-google-play.png" alt="QR code" width="120" height="120" />
          </a>
        </div>
      </div>
    </div>

    <!-- RIGHT: Image at Bottom Right -->
    <div class="hero-image-right">
      <img 
        src="/cake-hero.png" 
        alt="Cake" 
        class="cake-image"
      />
    </div>

  </div>

  <!-- Visible on arrival, with a direct route to the next section. -->
  <a class="glass-button" href="#how-it-works">
    <span>How it works</span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </a>
</section>
