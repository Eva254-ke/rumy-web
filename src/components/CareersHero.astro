---
import './CareersHero.css';
---

<section class="careers-hero">
  <div class="careers-hero-inner">
    <h1 class="careers-headline">Build something sweet.<br /><span class="careers-headline-em">With us.</span></h1>
    <p class="careers-subhead">We're looking for passionate bakers, engineers, and dreamers to help us bring the joy of live baking to the world.</p>
    
    <div class="careers-cta">
      <a href="#open-roles" class="btn btn-primary">View open roles</a>
      <a href="#why-join" class="btn btn-outline">Why join Rumy Cakes</a>
    </div>
  </div>
</section>
